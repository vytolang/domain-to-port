// vyto-proxyd — the proxy itself.
//
// One process, one epoll loop, non-blocking throughout. No threads, because
// Vyto has none and does not want them: a thread would force atomic
// refcounting on every object in the program. Concurrency here is fds, not
// threads, which is the shape vyto/net/server settled on too.
//
// This is deliberately NOT built on vyto/net/server. That module parses a
// request in order to *answer* it, and its parser is private. A proxy wants
// the opposite: read only as far as the Host header, then stop understanding
// the stream and forward it verbatim. Building on Socket + PollSet directly is
// both simpler and more correct here — it is what lets WebSocket upgrades and
// unknown methods pass through untouched.
//
// The loop holds one Tunnel per client, indexed in a table by BOTH of its fds,
// so a poll event on either side finds the same object in one lookup.

import { Socket, PollSet, RecvResult, socket_listen_on, socket_connect,
         socket_connect_async, POLL_READ, POLL_WRITE, POLL_ERR } from "vyto/net/socket";
import { cli, Cli } from "vyto/cli";
import { exit, getenv } from "vyto/os";
import { monoMs } from "vyto/util/time";  // monotonic: an idle timeout must not jump when the wall clock does
import { Table, readTable, normalize } from "vyto-proxy/src/routes";
import { routesPath, pidPath, ensureStateDir, stateDir } from "vyto-proxy/src/paths";
import { writePidFile, removePidFile } from "vyto-proxy/src/signal";
import { headEnd, hostHeader, HEAD_INCOMPLETE, HEAD_TOO_LARGE, MAX_HEAD } from "vyto-proxy/src/head";
import { Tunnel, Buf, BUF_SIZE, PH_HANDSHAKE, PH_READ_HEAD, PH_CONNECTING,
         PH_PIPING, PH_ERROR, PH_CLOSED, IO_WANT_READ, IO_WANT_WRITE,
         IO_ERROR, IO_EOF } from "vyto-proxy/src/tunnel";
import { TlsContext, tls_accept, OSSL_WANT_READ, OSSL_WANT_WRITE } from "vyto/crypto/openssl";
import { CertSource, acquire, CERT_SELF, CERT_FILES } from "vyto-proxy/src/tls";
import { SniSet, load } from "vyto-proxy/src/sni";
import { badGateway, noRoute, badRequest } from "vyto-proxy/src/errors";

export const VERSION: string = "0.1.0";

// A connection that has said nothing for this long is dropped. Slowloris
// defence: without it, an attacker holds a slot per idle socket for free.
const IDLE_MS: i64 = 60000;
// How often to sweep for those. Cheap because it walks only live slots.
const SWEEP_MS: i64 = 5000;

// Max connections. Each costs two fds and up to 128k of buffer, so the default
// is chosen to stay inside a normal 1024-fd ulimit with room to spare.
const MAX_CONNS: int = 256;

extern "C" {
    fn vp_ignore_sigpipe();
    fn vp_install_hup();
    fn vp_hup_pending(): i32;
    fn vp_clear_hup();
}

// SIGHUP is noticed by polling a flag, not by running Vyto code in the handler.
// A signal handler may interrupt malloc mid-lock, so allocating there can
// deadlock. The C-level handler does nothing but set a byte; the loop reads it
// between polls, where allocation is safe again.
//
// SIG_IGN on SIGPIPE is the other half: writing to a socket whose peer has gone
// away raises SIGPIPE, which by default kills the process. A proxy has peers
// vanish constantly, so it must see the EPIPE return value instead.
// ---------------------------------------------------------------------------

export class Proxy {
    table: Table;
    routes_file: string;
    listener: Socket;       // plain HTTP
    tls_listener: Socket;   // TLS, null unless --tls
    tls_ctx: TlsContext;    // the base server certificate, null unless --tls
    // Per-domain certificates. Held here for the process's life: the C lookup
    // table borrows the SSL_CTXs these own, so this must not be dropped while
    // any connection can still handshake.
    sni: SniSet;
    poll: PollSet;

    // Tunnels indexed by fd. Both of a tunnel's fds point at the same object,
    // so a ready fd resolves in one array read with no map lookup on the hot
    // path. Sized by the fd ceiling rather than the connection count because
    // that is what fds actually index.
    slots: Tunnel[];
    hi_fd: int;
    live: int;

    verbose: bool;
    running: bool;
    last_sweep: i64;

    fn init(routes_file: string, verbose: bool) {
        this.routes_file = routes_file;
        this.table = new Table();
        this.listener = null;
        this.tls_listener = null;
        this.tls_ctx = null;
        this.sni = null;
        this.poll = null;
        this.slots = [];
        this.hi_fd = 0;
        this.live = 0;
        this.verbose = verbose;
        this.running = true;
        this.last_sweep = 0;
    }

    fn log(msg: string) { if (this.verbose) { print(msg); } }

    // Load, or keep what we have.
    //
    // A broken routes file leaves the previous table in place and says so. The
    // alternative — adopting an empty table — turns one typo into a total
    // outage, which is exactly the failure a reload is supposed to avoid.
    fn reload(): bool {
        let t = readTable(this.routes_file);
        if (!t.ok()) {
            print(`vyto-proxyd: {t.err}`);
            print("vyto-proxyd: keeping the previous table");
            return false;
        }
        this.table = t;
        this.log(`loaded {t.count()} route(s) from {this.routes_file}`);
        return true;
    }

    fn ensureSlots(fd: int) {
        while (this.slots.len <= fd) { this.slots.push(null); }
    }

    fn attach(fd: int, t: Tunnel) {
        this.ensureSlots(fd);
        this.slots[fd] = t;
        if (fd > this.hi_fd) { this.hi_fd = fd; }
    }

    fn detach(fd: int) {
        if (fd >= 0 && fd < this.slots.len) { this.slots[fd] = null; }
    }

    // ---- lifecycle ----

    fn listen(host: string, port: int, backlog: int): bool {
        this.listener = socket_listen_on(host, port, backlog);
        if (this.listener == null) { return false; }
        if (!this.listener.setNonBlocking(true)) { return false; }
        this.poll = new PollSet();
        return this.poll.add(this.listener, POLL_READ);
    }

    fn listenTls(host: string, port: int, backlog: int, ctx: TlsContext): bool {
        this.tls_ctx = ctx;
        this.tls_listener = socket_listen_on(host, port, backlog);
        if (this.tls_listener == null) { return false; }
        if (!this.tls_listener.setNonBlocking(true)) { return false; }
        return this.poll.add(this.tls_listener, POLL_READ);
    }

    fn run() {
        let lfd = this.listener.fd as int;
        let tfd = -1;
        if (this.tls_listener != null) { tfd = this.tls_listener.fd as int; }
        this.last_sweep = monoMs();

        while (this.running) {
            let n = this.poll.wait(1000);

            // Signals land between polls, where allocation is safe.
            if ((vp_hup_pending() as int) != 0) {
                vp_clear_hup();
                this.log("SIGHUP: reloading routes");
                this.reload();
            }

            let now = monoMs();
            if (n > 0) {
                let i = 0;
                while (i < n) {
                    let fd = this.poll.readyFd(i);
                    let ev = this.poll.readyEvents(i);
                    if (fd == lfd) { this.acceptBurst(this.listener, false, now); }
                    else if (fd == tfd) { this.acceptBurst(this.tls_listener, true, now); }
                    else { this.service(fd, ev, now); }
                    i += 1;
                }
            }

            if (now - this.last_sweep >= SWEEP_MS) {
                this.sweep(now);
                this.last_sweep = now;
            }
        }
    }

    // Drain the accept queue. One wakeup can mean many pending connections, and
    // accepting only one per wakeup gives away most of the throughput.
    fn acceptBurst(lis: Socket, is_tls: bool, now: i64) {
        while (true) {
            if (this.live >= MAX_CONNS) { return; }
            let c = lis.tryAccept();
            if (c == null) { return; }
            c.setNoDelay(true);          // a proxy hop must not add Nagle delay
            let t = new Tunnel(c, now);
            let fd = c.fd as int;

            if (is_tls) {
                // tls_accept wraps the fd but does not handshake; the handshake
                // is driven by the loop, a step at a time, because the socket is
                // non-blocking.
                t.tls = tls_accept(this.tls_ctx, fd);
                if (t.tls == null || !t.tls.ok()) { c.close(); continue; }
                t.phase = PH_HANDSHAKE;
            }

            this.attach(fd, t);
            this.live += 1;
            this.poll.add(c, POLL_READ);
        }
    }

    // Drive one handshake step and re-arm for whichever direction OpenSSL
    // asked for. Waiting on the wrong direction here is a hang, not an error.
    fn handshake(t: Tunnel) {
        let r = t.tls.handshakeStep();
        if (r == 1) {
            t.tls_want_write = false;
            t.phase = PH_READ_HEAD;
            // Read straight away rather than waiting for another epoll wakeup.
            //
            // The final handshake flight and the client's first request often
            // arrive in the same TCP segment, so by the time the handshake
            // completes those request bytes are already buffered INSIDE the SSL
            // object — consumed from the socket, invisible to epoll. Waiting for
            // readability there is waiting for a packet that has already been
            // delivered, and the connection hangs until the idle sweep.
            this.readHead(t);
            return;
        }
        if (r == OSSL_WANT_READ) { t.tls_want_write = false; return; }
        if (r == OSSL_WANT_WRITE) { t.tls_want_write = true; return; }
        // A failed handshake gets no HTTP reply: the peer has no TLS session to
        // read one over, so anything we sent would be unframed noise.
        this.log(`tls handshake failed: {t.tls.lastError()}`);
        t.front_dead = true;
    }

    fn service(fd: int, ev: int, now: i64) {
        if (fd < 0 || fd >= this.slots.len) { return; }
        let t = this.slots[fd];
        if (t == null) { return; }
        t.last_ms = now;

        let is_front = t.front != null && (t.front.fd as int) == fd;

        if (t.phase == PH_HANDSHAKE) {
            if (is_front) { this.handshake(t); }
        } else if (t.phase == PH_READ_HEAD) {
            if (is_front) { this.readHead(t); }
        } else if (t.phase == PH_CONNECTING) {
            if (!is_front) { this.finishConnect(t); }
        } else if (t.phase == PH_PIPING) {
            this.pipe(t, is_front, ev);
        } else if (t.phase == PH_ERROR) {
            if (is_front) { this.flushError(t); }
        }

        if (t.finished()) { this.reap(t); }
        else { this.rearm(t); }
    }

    // ---- phase: reading the head ----

    fn readHead(t: Tunnel) {
        // Through the seam: on a TLS connection these bytes come out of the SSL
        // object, not off the socket. Reading the socket directly here would
        // hand the parser ciphertext, which never resolves into a header block.
        let buf = bytes(4096);
        let n = t.frontRead(buf, 4096);
        if (n == IO_WANT_READ) { t.tls_want_write = false; return; }
        if (n == IO_WANT_WRITE) { t.tls_want_write = true; return; }
        if (n == IO_EOF) { t.front_eof = true; t.phase = PH_CLOSED; return; }
        if (n < 0) { t.front_dead = true; return; }
        t.tls_want_write = false;

        if (!t.headAppend(buf, n, MAX_HEAD)) {
            this.fail(t, badRequest());
            return;
        }

        let e = headEnd(t.head, t.head_len);
        if (e == HEAD_INCOMPLETE) { return; }
        if (e == HEAD_TOO_LARGE) { this.fail(t, badRequest()); return; }

        let raw = hostHeader(t.head, t.head_len);
        if (raw.is_empty()) { this.fail(t, badRequest()); return; }

        // Normalize once, and use the normalized name everywhere the user sees
        // it. A Host of "app.local:8443" routes fine — lookup strips the port —
        // but echoing the raw value into an error page produces a
        // `domain-to-port -d app.local:8443` suggestion that would be rejected
        // as an unusable domain if anyone pasted it.
        let host = normalize(raw);
        if (host.is_empty()) { this.fail(t, badRequest()); return; }

        let port = this.table.lookup(host);
        if (port == 0) {
            this.log(`404 {host}`);
            this.fail(t, noRoute(host));
            return;
        }
        t.host = host;
        t.port = port;

        // Everything read so far — head and any body bytes that arrived with
        // it — is what the backend must receive first.
        t.f2b.append(t.head, t.head_len);
        t.head = bytes(0);
        t.head_len = 0;

        this.connectBackend(t);
    }

    // ---- phase: connecting ----

    fn connectBackend(t: Tunnel) {
        let b = socket_connect_async("127.0.0.1", t.port);
        if (b == null) { this.fail(t, badGateway(t.host, t.port)); return; }
        b.setNoDelay(true);
        t.back = b;
        t.phase = PH_CONNECTING;
        this.attach(b.fd as int, t);
        this.poll.add(b, POLL_WRITE);
        this.log(`{t.host} -> :{t.port}`);
    }

    fn finishConnect(t: Tunnel) {
        if (t.back.connResult() != 0) {
            // Refused: the route is right, the server is not there. This is the
            // case the 502 page exists for.
            this.log(`502 {t.host} -> :{t.port} (refused)`);
            this.poll.remove(t.back);
            this.detach(t.back.fd as int);
            t.back.close();
            t.back = null;
            this.fail(t, badGateway(t.host, t.port));
            return;
        }
        t.phase = PH_PIPING;
    }

    // ---- phase: piping ----

    fn pipe(t: Tunnel, is_front: bool, ev: int) {
        if (is_front) {
            if ((ev & POLL_READ) != 0) { this.move(t, t.front, t.f2b, true); }
            if ((ev & POLL_WRITE) != 0) { this.flush(t, t.front, t.b2f, true); }
        } else {
            if ((ev & POLL_READ) != 0) { this.move(t, t.back, t.b2f, false); }
            if ((ev & POLL_WRITE) != 0) { this.flush(t, t.back, t.f2b, false); }
        }
        // A read on one side may have filled a buffer the other side can now
        // write, so try the paired write immediately rather than waiting for
        // another poll wakeup. This is what keeps a loopback hop at one
        // syscall round-trip instead of two.
        if (!t.f2b.isEmpty() && t.back != null) { this.flush(t, t.back, t.f2b, false); }
        if (!t.b2f.isEmpty() && t.front != null) { this.flush(t, t.front, t.b2f, true); }
    }

    // src -> buf
    fn move(t: Tunnel, s: Socket, buf: Buf, from_front: bool) {
        let room = buf.space();
        if (room <= 0) { return; }
        let want = room;
        if (want > 32768) { want = 32768; }

        if (from_front) {
            // Through the seam: plain or TLS, the loop does not branch.
            let tmp = bytes(want);
            let n = t.frontRead(tmp, want);
            if (n == IO_WANT_READ) { t.tls_want_write = false; return; }
            if (n == IO_WANT_WRITE) { t.tls_want_write = true; return; }
            if (n == IO_EOF) { t.front_eof = true; return; }
            if (n < 0) { t.front_dead = true; return; }
            t.tls_want_write = false;
            buf.append(tmp, n);
            return;
        }

        if (s == null) { return; }
        let r = s.tryRecv(want);
        if (r.wouldBlock()) { return; }
        if (r.status == 0) {
            // Clean EOF: the peer stopped talking but may still be listening.
            t.back_eof = true;
            return;
        }
        if (r.status < 0) {
            // A read error (ECONNRESET and friends) means the peer is gone in
            // both directions, not merely done sending.
            t.back_dead = true;
            return;
        }
        buf.append(r.data, r.status);
    }

    // buf -> dst, resuming a partial write from the offset.
    fn flush(t: Tunnel, s: Socket, buf: Buf, to_front: bool) {
        while (!buf.isEmpty()) {
            let n = buf.pending();
            let sent = 0;

            if (to_front) {
                sent = t.frontWrite(buf.data, buf.off, n);
                // A TLS write can block on READABILITY, so the direction to
                // wait for is whatever OpenSSL said, not "writable".
                if (sent == IO_WANT_READ) { t.tls_want_write = false; return; }
                if (sent == IO_WANT_WRITE) { t.tls_want_write = true; return; }
                if (sent < 0) { t.front_dead = true; return; }
                t.tls_want_write = false;
            } else {
                if (s == null) { return; }
                sent = s.trySendRaw(buf.data as cstring, buf.off, n);
                if (sent == -1) { return; }          // would block; poll will call us
                if (sent < 0) {
                    // A failed write means this peer cannot receive anything
                    // ever again — distinct from EOF, which only means it
                    // stopped talking. Marking it dead lets finished() tear the
                    // tunnel down now rather than leaving both fds to the sweep.
                    t.back_dead = true;
                    return;
                }
            }

            buf.off += sent;
            if (buf.isEmpty()) { buf.compact(); return; }
            if (sent == 0) { return; }
        }
    }

    // ---- phase: error ----

    // Abandon the backend and answer the client ourselves.
    fn fail(t: Tunnel, response: string) {
        t.phase = PH_ERROR;
        t.b2f.len = 0;
        t.b2f.off = 0;
        let n = response.len;
        if (n > BUF_SIZE) { n = BUF_SIZE; }
        let i = 0;
        while (i < n) { t.b2f.data[i] = response[i] as byte; i += 1; }
        t.b2f.len = n;
        this.flushError(t);
    }

    fn flushError(t: Tunnel) {
        if (t.front == null) { return; }
        this.flush(t, t.front, t.b2f, true);
    }

    // ---- poll re-arming ----

    // Tell epoll what this tunnel currently cares about. Called after every
    // event because the answer changes as buffers fill and drain — that is
    // precisely how backpressure is applied.
    fn rearm(t: Tunnel) {
        if (t.front != null) {
            let e = 0;
            if (t.wantFrontRead()) { e = e | POLL_READ; }
            if (t.wantFrontWrite()) { e = e | POLL_WRITE; }
            this.poll.modify(t.front, e);
        }
        if (t.back != null && t.phase == PH_PIPING) {
            let e = 0;
            if (t.wantBackRead()) { e = e | POLL_READ; }
            if (t.wantBackWrite()) { e = e | POLL_WRITE; }
            this.poll.modify(t.back, e);
        }
    }

    fn reap(t: Tunnel) {
        if (t.front != null) {
            let fd = t.front.fd as int;
            this.poll.remove(t.front);
            this.detach(fd);
        }
        if (t.back != null) {
            let fd = t.back.fd as int;
            this.poll.remove(t.back);
            this.detach(fd);
        }
        t.close();
        this.live -= 1;
        if (this.live < 0) { this.live = 0; }
    }

    // Drop connections that have gone quiet. Walks live slots only.
    fn sweep(now: i64) {
        let fd = 0;
        while (fd <= this.hi_fd && fd < this.slots.len) {
            let t = this.slots[fd];
            if (t != null && t.front != null && (t.front.fd as int) == fd) {
                if (now - t.last_ms > IDLE_MS) { this.reap(t); }
            }
            fd += 1;
        }
    }
}

// ---------------------------------------------------------------------------

// Why did a bind fail?
//
// "cannot listen" covers two situations that want opposite responses, and
// guessing wrong sends the reader somewhere useless: a low port without the
// capability, and a port somebody else already owns. On a development machine
// both are often true at once — Apache and nginx install enabled and hold :80 —
// so a message that only mentions setcap leads you to grant the capability and
// then fail again for the other reason.
//
// Connecting is what distinguishes them. If something accepts, the port is
// occupied; if nothing does, the bind failed for want of privilege.
fn explainBindFailure(host: string, port: int) {
    let probe = socket_connect("127.0.0.1", port);
    let occupied = probe != null;
    if (probe != null) { probe.close(); }

    if (occupied) {
        print(`  something is already listening on port {port}.`);
        print("  find it with:");
        print(`    sudo ss -lntp | grep ':{port} '`);
        print("  then move it, stop it, or run this proxy on another port with -p.");
        return;
    }
    if (port < 1024) {
        print("  ports below 1024 need privilege. Grant it once with:");
        print("    sudo setcap cap_net_bind_service=+ep ./vyto-proxyd");
        return;
    }
    print(`  the address {host} may not exist on this machine.`);
}

fn main() {
    let app = new Cli("vyto-proxyd", "route domains to local ports");
    app.intOption("port", "port to listen on").short("p").meta("PORT").dfltInt(80);
    app.option("host", "address to bind").meta("ADDR").dflt("0.0.0.0");
    app.option("routes", "routes file to read").meta("PATH");
    app.flag("tls", "also terminate TLS (on --tls-port)");
    app.intOption("tls-port", "port for TLS").meta("PORT").dfltInt(443);
    app.option("cert", "certificate chain, PEM (leaf first)").meta("PATH");
    app.option("key", "private key, PEM").meta("PATH");
    app.option("certs", "directory of per-domain <domain>.crt/.key pairs").meta("DIR");
    app.flag("verbose", "log every routing decision").short("v");
    app.flag("version", "print the version and exit");

    if (!app.parse(args())) { print(app.report()); exit(app.exitCode()); }
    if (app.helpWanted()) { print(app.usage()); return; }
    if (app.on("version")) { print("vyto-proxyd " + VERSION); return; }

    if (!ensureStateDir()) {
        print(`vyto-proxyd: cannot create {stateDir()}`);
        exit(1);
    }

    let rf = app.get("routes");
    if (rf.is_empty()) { rf = routesPath(); }

    let p = new Proxy(rf, app.on("verbose"));
    if (!p.reload()) { exit(1); }

    // SIGPIPE would otherwise kill us the first time a client hangs up
    // mid-response; SIGHUP is our reload.
    vp_ignore_sigpipe();
    vp_install_hup();

    let port = app.getInt("port");
    let host = app.get("host");
    if (!p.listen(host, port, 512)) {
        print(`vyto-proxyd: cannot listen on {host}:{port}`);
        explainBindFailure(host, port);
        exit(1);
    }

    // TLS second, so a certificate problem is reported after we know the plain
    // listener works — and so --tls failing never silently costs you :80.
    let tls_line = "";
    if (app.on("tls")) {
        let src = acquire(app.get("cert"), app.get("key"), p.table);
        if (!src.ok()) {
            print(`vyto-proxyd: TLS: {src.err}`);
            exit(1);
        }
        // Per-domain certificates, if a directory was given. Loaded before the
        // listener opens so a bad pair is a startup error, not a handshake that
        // fails for one domain once someone visits it.
        let certs_dir = app.get("certs");
        if (!certs_dir.is_empty()) {
            let set = load(certs_dir);
            if (!set.ok()) {
                print(`vyto-proxyd: {certs_dir}: {set.err}`);
                exit(1);
            }
            if (!set.install(src.ctx)) {
                print("vyto-proxyd: could not install the SNI table");
                exit(1);
            }
            p.sni = set;
        }

        let tport = app.getInt("tls-port");
        if (!p.listenTls(host, tport, 512, src.ctx)) {
            print(`vyto-proxyd: cannot listen on {host}:{tport}`);
            explainBindFailure(host, tport);
            exit(1);
        }
        if (src.kind == CERT_SELF) {
            tls_line = `TLS on {host}:{tport} with a SELF-SIGNED certificate — browsers will warn`;
        } else {
            tls_line = `TLS on {host}:{tport}`;
        }
        if (p.sni != null && p.sni.count() > 0) {
            tls_line = tls_line + `, {p.sni.count()} per-domain certificate(s)`;
        }
    }

    if (!writePidFile(pidPath())) {
        print(`vyto-proxyd: cannot write {pidPath()}`);
        exit(1);
    }

    print(`vyto-proxyd listening on {host}:{port} — {p.table.count()} route(s)`);
    if (!tls_line.is_empty()) { print("  " + tls_line); }
    p.run();
    removePidFile(pidPath());
}
